diff --git a/app/src/main/res/color/selector_input_stroke.xml b/app/src/main/res/color/selector_input_stroke.xml
new file mode 100644
index 0000000..52c6718
--- /dev/null
+++ b/app/src/main/res/color/selector_input_stroke.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- 입력칸 테두리: 포커스 → 브랜드 그린, 기본 → 회색 (에러 색은 boxStrokeErrorColor로 따로 지정) -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:color="@color/border_brand" android:state_focused="true" />
+    <item android:color="@color/border_input" />
+</selector>
