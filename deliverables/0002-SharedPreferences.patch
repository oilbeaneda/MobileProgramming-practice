+package com.app.jjanchall.util
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AuthValidatorTest {
+
+    @Test
+    fun email() {
+        assertTrue(AuthValidator.isValidEmail("example@sungshin.ac.kr"))
+        assertTrue(AuthValidator.isValidEmail("  a.b+c@test.com "))
+        assertFalse(AuthValidator.isValidEmail(""))
+        assertFalse(AuthValidator.isValidEmail("example"))
+        assertFalse(AuthValidator.isValidEmail("example@"))
+        assertFalse(AuthValidator.isValidEmail("example@sungshin"))
+    }
+
+    @Test
+    fun normalizeEmail() {
+        assertEquals("abc@test.com", AuthValidator.normalizeEmail("  ABC@Test.com "))
+    }
+
+    @Test
+    fun password() {
+        assertFalse(AuthValidator.isValidPassword("12345"))
+        assertTrue(AuthValidator.isValidPassword("123456"))
+    }
+
+    @Test
+    fun nickname() {
+        assertFalse(AuthValidator.isValidNickname("짠"))
+        assertTrue(AuthValidator.isValidNickname("짠순이"))
+        assertTrue(AuthValidator.isValidNickname("가나다라마바사아자차"))
+        assertFalse(AuthValidator.isValidNickname("가나다라마바사아자차카"))
+        assertFalse(AuthValidator.isValidNickname("   "))
+    }
+}
diff --git a/app/src/test/java/com/app/jjanchall/util/PasswordHasherTest.kt b/app/src/test/java/com/app/jjanchall/util/PasswordHasherTest.kt
new file mode 100644
index 0000000..7e4e7ac
--- /dev/null
+++ b/app/src/test/java/com/app/jjanchall/util/PasswordHasherTest.kt
@@ -0,0 +1,33 @@
+package com.app.jjanchall.util
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PasswordHasherTest {
+
+    @Test
+    fun sameSaltSameHash() {
+        val salt = PasswordHasher.newSalt()
+        assertEquals(PasswordHasher.hash("pw1234", salt), PasswordHasher.hash("pw1234", salt))
+    }
+
+    @Test
+    fun differentSaltDifferentHash() {
+        assertNotEquals(
+            PasswordHasher.hash("pw1234", PasswordHasher.newSalt()),
+            PasswordHasher.hash("pw1234", PasswordHasher.newSalt()),
+        )
+    }
+
+    @Test
+    fun matches() {
+        val salt = PasswordHasher.newSalt()
+        val hash = PasswordHasher.hash("pw1234", salt)
+        assertTrue(PasswordHasher.matches("pw1234", salt, hash))
+        assertFalse(PasswordHasher.matches("pw12345", salt, hash))
+        assertFalse(hash.contains("pw1234"))
+    }
+}
